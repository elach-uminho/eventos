# Generic .gitignore for the "eventos" project

# macOS
.DS_Store
.AppleDouble
.LSOverride


# Environment / secrets
.env
.env.*.local
.env.local
*.pem
*.key


# IDEs / editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.iml
*.swp
*.swo


# Logs & reports
*.log
npm-debug.log*
yarn-debug.log*
coverage/
nyc_output/

# Misc
.Dockerfile.swp
docker-compose.override.yml
.bundle/
!.gitignore